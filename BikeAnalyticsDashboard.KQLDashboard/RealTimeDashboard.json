  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f0478628-4237-4fc0-81ec-1946a478d0b5"
      },
      "text": "// Show the latest availability snapshot by neighbourhood\r\nBikeShareRaw\r\n| summarize arg_max(ingestion_time(), *) by BikepointID\r\n| summarize\r\n    TotalBikes = sum(No_Bikes),\r\n    TotalEmptyDocks = sum(No_Empty_Docks),\r\n    BikePoints = dcount(BikepointID)\r\n    by Neighbourhood\r\n| extend TotalDocks = TotalBikes + TotalEmptyDocks\r\n| extend AvailabilityPercent = round(100.0 * TotalBikes / TotalDocks, 1)\r\n| order by TotalBikes desc",
      "id": "408aeae5-34e3-4e71-827d-3854d90d88ce",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f0478628-4237-4fc0-81ec-1946a478d0b5"
      },
      "text": "// Show current bike availability by neighbourhood\r\nBikeShareRaw\r\n| summarize arg_max(ingestion_time(), *) by BikepointID\r\n| summarize AvailableBikes = sum(No_Bikes) by Neighbourhood\r\n| top 10 by AvailableBikes desc\r\n| order by AvailableBikes asc",
      "id": "fe16c1b0-48ec-4203-b2aa-b70c8728aa27",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f0478628-4237-4fc0-81ec-1946a478d0b5"
      },
      "text": "// Calculate the total number of currently available bikes\r\nBikeShareRaw\r\n| summarize arg_max(ingestion_time(), *) by BikepointID\r\n| summarize AvailableBikes = sum(No_Bikes)",
      "id": "925003f9-401b-49e6-be12-bf93b56f1486",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f0478628-4237-4fc0-81ec-1946a478d0b5"
      },
      "text": "// Calculate the total number of currently available empty docks\r\nBikeShareRaw\r\n| summarize arg_max(ingestion_time(), *) by BikepointID\r\n| summarize AvailableEmptyDocks = sum(No_Empty_Docks)",
      "id": "158f33c4-b7a7-4349-8bfd-6bc733a91d60",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "f0478628-4237-4fc0-81ec-1946a478d0b5"
      },
      "text": "// Show the total bike availability trend across all neighbourhoods\r\nBikeAvailabilityMinute\r\n| summarize TotalAvailableBikes = sum(TotalBikes) by Window_End_Time\r\n| order by Window_End_Time asc\r\n| render timechart",
      "id": "92a6db2e-18d3-4322-a970-bcdaf5c9ae97",
      "usedVariables": []
    }
  ],
